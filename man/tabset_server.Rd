      types = c("Plot" = "plot", "Table" = "table"),
      initial = "plot",
      ui = function(id, type) {
        ns = shiny::NS(id)
        if (type == "plot") shiny::plotOutput(ns("out")) else shiny::tableOutput(ns("out"))
      },
      server = function(input, output, session, type) {
        if (type == "plot") {
          output$out = shiny::renderPlot(plot(rnorm(100)))
